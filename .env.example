# Copy this file to ".env" and fill in your real values.
# .env is gitignored — your tokens stay local and are never committed.

# --- Exercise (training) bot ---
EXERCISE_BOT_TOKEN=paste-exercise-bot-token-here
EXERCISE_CHAT_ID=paste-your-chat-id-here

# --- Dinner menu bot (only needed to test dinner reminders) ---
DINNER_MENU_BOT_TOKEN=paste-dinner-bot-token-here
DINNER_MENU_CHATID=paste-your-chat-id-here

# --- Optional: nicer morning wording via Claude (works fine without it) ---
# ANTHROPIC_API_KEY=sk-ant-...
